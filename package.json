{
  "name": "bakesbymom-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Bakes by Mom design system: design tokens, React component library and Storybook.",
  "type": "module",
  "workspaces": [
    "packages/tokens",
    "packages/ui"
  ],
  "scripts": {
    "build": "npm run build -w @bakesbymom/tokens && npm run build -w @bakesbymom/ui",
    "build:tokens": "npm run build -w @bakesbymom/tokens",
    "typecheck": "npm run typecheck -w @bakesbymom/ui && tsc -p .storybook/tsconfig.json",
    "test": "npm run test -w @bakesbymom/tokens && npm run test -w @bakesbymom/ui",
    "storybook": "npm run build:tokens && storybook dev -p 6006",
    "build-storybook": "npm run build:tokens && storybook build -o storybook-static",
    "format": "prettier --write \"packages/**/*.{ts,tsx,mjs,css,json,md}\" \"stories/**/*.{ts,tsx,css,mdx}\" \".storybook/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,mjs,css,json,md}\" \"stories/**/*.{ts,tsx,css,mdx}\" \".storybook/**/*.{ts,tsx,css}\"",
    "check": "npm run format:check && npm run build && npm run typecheck && npm run test && npm run build-storybook"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

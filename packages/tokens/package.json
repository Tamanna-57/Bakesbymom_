{
  "name": "@bakesbymom/tokens",
  "version": "0.1.0",
  "description": "Bakes by Mom design tokens (W3C DTCG source) built to CSS, SCSS, JS/TS, JSON and a Tailwind v4 theme.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/js/tokens.js",
  "types": "./dist/js/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/js/tokens.d.ts",
      "default": "./dist/js/tokens.js"
    },
    "./css": "./dist/css/tokens.css",
    "./tokens.css": "./dist/css/tokens.css",
    "./tailwind.css": "./dist/tailwind/theme.css",
    "./scss": "./dist/scss/_tokens.scss",
    "./json": "./dist/json/tokens.json",
    "./docs.json": "./dist/docs/tokens.json",
    "./dtcg.json": "./dist/dtcg/tokens.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && vitest run"
  },
  "devDependencies": {
    "style-dictionary": "^5.7.0"
  }
}

{
  "color": {
    "bg": {
      "$description": "Surfaces. Depth comes from stepping through creams, not from shadows.",
      "canvas": { "$type": "color", "$value": "{color.cream.100}", "$description": "Default page background." },
      "surface": { "$type": "color", "$value": "{color.cream.50}", "$description": "Cards and panels on the canvas." },
      "raised": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Highest lift: inputs, polaroid borders, popovers."
      },
      "sunken": { "$type": "color", "$value": "{color.cream.200}", "$description": "Alternate section band." },
      "kraft": {
        "$type": "color",
        "$value": "{color.cream.300}",
        "$description": "Quiet fills such as disabled controls and table headers."
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.cocoa.900}",
        "$description": "Dark cocoa band (footer, marquee)."
      },
      "brand": {
        "$type": "color",
        "$value": "{color.cherry.700}",
        "$description": "Full cherry band. Use once per page at most."
      },
      "brand-subtle": { "$type": "color", "$value": "{color.cherry.50}" },
      "blush": { "$type": "color", "$value": "{color.strawberry.100}", "$description": "Strawberry-milk section." },
      "sky": { "$type": "color", "$value": "{color.blueberry.100}", "$description": "Powder-blue section." },
      "butter": { "$type": "color", "$value": "{color.butter.100}", "$description": "Custard section." },
      "pistachio": { "$type": "color", "$value": "{color.pistachio.100}", "$description": "Pistachio section." },
      "caramel": { "$type": "color", "$value": "{color.caramel.100}", "$description": "Apricot section." },
      "lavender": { "$type": "color", "$value": "{color.lavender.100}", "$description": "Ube section (minor accent)." }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.cocoa.900}",
        "$description": "Body and headings. 14.2:1 on canvas."
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.cocoa.700}",
        "$description": "Supporting copy. 9.9:1 on canvas."
      },
      "muted": {
        "$type": "color",
        "$value": "{color.cocoa.500}",
        "$description": "Captions and metadata. 5.0:1 on canvas, 4.6:1 on sunken."
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.cocoa.300}",
        "$description": "Disabled labels (exempt from contrast minimums)."
      },
      "inverse": { "$type": "color", "$value": "{color.cream.50}", "$description": "Text on cocoa, cherry or forest." },
      "brand": {
        "$type": "color",
        "$value": "{color.cherry.700}",
        "$description": "Brand headings, logo and script accents."
      },
      "link": { "$type": "color", "$value": "{color.cherry.600}" },
      "link-hover": { "$type": "color", "$value": "{color.cherry.800}" }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{color.cocoa.900}",
        "$description": "Sticker outline. The structural line of the system."
      },
      "subtle": { "$type": "color", "$value": "{color.cream.300}", "$description": "Hairline rules and dividers." },
      "muted": { "$type": "color", "$value": "{color.cocoa.200}", "$description": "Input borders at rest." },
      "brand": { "$type": "color", "$value": "{color.cherry.600}", "$description": "Brand frames (SugarLace-style)." },
      "focus": {
        "$type": "color",
        "$value": "{color.blueberry.700}",
        "$description": "Focus ring. A cool blue so it never reads as an error."
      }
    },
    "action": {
      "primary": {
        "bg": { "$type": "color", "$value": "{color.cherry.600}" },
        "bg-hover": { "$type": "color", "$value": "{color.cherry.700}" },
        "bg-active": { "$type": "color", "$value": "{color.cherry.800}" },
        "fg": { "$type": "color", "$value": "{color.cream.50}" }
      },
      "secondary": {
        "bg": { "$type": "color", "$value": "{color.cream.50}" },
        "bg-hover": { "$type": "color", "$value": "{color.strawberry.100}" },
        "bg-active": { "$type": "color", "$value": "{color.strawberry.200}" },
        "fg": { "$type": "color", "$value": "{color.cocoa.900}" },
        "border": { "$type": "color", "$value": "{color.cocoa.900}" }
      },
      "soft": {
        "bg": { "$type": "color", "$value": "{color.strawberry.200}" },
        "bg-hover": { "$type": "color", "$value": "{color.strawberry.300}" },
        "bg-active": { "$type": "color", "$value": "{color.strawberry.400}" },
        "fg": { "$type": "color", "$value": "{color.cocoa.900}" }
      },
      "ghost": {
        "bg-hover": { "$type": "color", "$value": "{color.cocoa.50}" },
        "fg": { "$type": "color", "$value": "{color.cherry.700}" }
      },
      "disabled": {
        "bg": { "$type": "color", "$value": "{color.cream.300}" },
        "fg": { "$type": "color", "$value": "{color.cocoa.400}" }
      }
    },
    "status": {
      "success": {
        "bg": { "$type": "color", "$value": "{color.pistachio.100}" },
        "fg": { "$type": "color", "$value": "{color.pistachio.800}" },
        "solid": { "$type": "color", "$value": "{color.pistachio.700}" }
      },
      "warning": {
        "bg": { "$type": "color", "$value": "{color.butter.100}" },
        "fg": { "$type": "color", "$value": "{color.butter.800}" },
        "solid": { "$type": "color", "$value": "{color.butter.400}" }
      },
      "danger": {
        "bg": { "$type": "color", "$value": "{color.cherry.50}" },
        "fg": { "$type": "color", "$value": "{color.cherry.800}" },
        "solid": { "$type": "color", "$value": "{color.cherry.600}" }
      },
      "info": {
        "bg": { "$type": "color", "$value": "{color.blueberry.100}" },
        "fg": { "$type": "color", "$value": "{color.blueberry.800}" },
        "solid": { "$type": "color", "$value": "{color.blueberry.700}" }
      }
    },
    "tone": {
      "$description": "Flavor tones shared by Badge, Card, Marquee, PriceTag and patterns. bg/fg is the soft pairing; solid/on-solid is the filled pairing. Every pair is at least AA.",
      "cherry": {
        "bg": { "$type": "color", "$value": "{color.cherry.50}" },
        "border": { "$type": "color", "$value": "{color.cherry.200}" },
        "fg": { "$type": "color", "$value": "{color.cherry.700}" },
        "solid": { "$type": "color", "$value": "{color.cherry.600}" },
        "on-solid": { "$type": "color", "$value": "{color.cream.50}" },
        "pattern": { "$type": "color", "$value": "{color.cherry.500}" }
      },
      "strawberry": {
        "bg": { "$type": "color", "$value": "{color.strawberry.100}" },
        "border": { "$type": "color", "$value": "{color.strawberry.300}" },
        "fg": { "$type": "color", "$value": "{color.strawberry.800}" },
        "solid": { "$type": "color", "$value": "{color.strawberry.300}" },
        "on-solid": { "$type": "color", "$value": "{color.cocoa.900}" },
        "pattern": { "$type": "color", "$value": "{color.strawberry.200}" }
      },
      "blueberry": {
        "bg": { "$type": "color", "$value": "{color.blueberry.100}" },
        "border": { "$type": "color", "$value": "{color.blueberry.300}" },
        "fg": { "$type": "color", "$value": "{color.blueberry.800}" },
        "solid": { "$type": "color", "$value": "{color.blueberry.200}" },
        "on-solid": { "$type": "color", "$value": "{color.cocoa.900}" },
        "pattern": { "$type": "color", "$value": "{color.blueberry.200}" }
      },
      "butter": {
        "bg": { "$type": "color", "$value": "{color.butter.100}" },
        "border": { "$type": "color", "$value": "{color.butter.300}" },
        "fg": { "$type": "color", "$value": "{color.butter.800}" },
        "solid": { "$type": "color", "$value": "{color.butter.300}" },
        "on-solid": { "$type": "color", "$value": "{color.cocoa.900}" },
        "pattern": { "$type": "color", "$value": "{color.butter.200}" }
      },
      "pistachio": {
        "bg": { "$type": "color", "$value": "{color.pistachio.100}" },
        "border": { "$type": "color", "$value": "{color.pistachio.300}" },
        "fg": { "$type": "color", "$value": "{color.pistachio.800}" },
        "solid": { "$type": "color", "$value": "{color.pistachio.700}" },
        "on-solid": { "$type": "color", "$value": "{color.cream.50}" },
        "pattern": { "$type": "color", "$value": "{color.pistachio.200}" }
      },
      "caramel": {
        "bg": { "$type": "color", "$value": "{color.caramel.100}" },
        "border": { "$type": "color", "$value": "{color.caramel.300}" },
        "fg": { "$type": "color", "$value": "{color.caramel.800}" },
        "solid": { "$type": "color", "$value": "{color.caramel.300}" },
        "on-solid": { "$type": "color", "$value": "{color.cocoa.900}" },
        "pattern": { "$type": "color", "$value": "{color.caramel.200}" }
      },
      "lavender": {
        "bg": { "$type": "color", "$value": "{color.lavender.100}" },
        "border": { "$type": "color", "$value": "{color.lavender.300}" },
        "fg": { "$type": "color", "$value": "{color.lavender.800}" },
        "solid": { "$type": "color", "$value": "{color.lavender.200}" },
        "on-solid": { "$type": "color", "$value": "{color.cocoa.900}" },
        "pattern": { "$type": "color", "$value": "{color.lavender.200}" }
      },
      "cocoa": {
        "bg": { "$type": "color", "$value": "{color.cocoa.100}" },
        "border": { "$type": "color", "$value": "{color.cocoa.300}" },
        "fg": { "$type": "color", "$value": "{color.cocoa.900}" },
        "solid": { "$type": "color", "$value": "{color.cocoa.900}" },
        "on-solid": { "$type": "color", "$value": "{color.cream.50}" },
        "pattern": { "$type": "color", "$value": "{color.cocoa.900}" }
      },
      "cream": {
        "bg": { "$type": "color", "$value": "{color.cream.200}" },
        "border": { "$type": "color", "$value": "{color.cream.400}" },
        "fg": { "$type": "color", "$value": "{color.cocoa.900}" },
        "solid": { "$type": "color", "$value": "{color.cream.300}" },
        "on-solid": { "$type": "color", "$value": "{color.cocoa.900}" },
        "pattern": { "$type": "color", "$value": "{color.cream.300}" }
      }
    }
  }
}

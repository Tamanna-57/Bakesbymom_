{
  "shadow": {
    "$description": "Pasticceria shadows: soft and close, like a cake box on a marble counter. \"sticker\" keeps its name so components stay put.",
    "sticker": {
      "sm": {
        "$type": "shadow",
        "$value": {
          "color": "#32180b1f",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "0px"
        }
      },
      "md": {
        "$type": "shadow",
        "$value": {
          "color": "#32180b38",
          "offsetX": "0px",
          "offsetY": "10px",
          "blur": "26px",
          "spread": "-14px"
        }
      },
      "lg": {
        "$type": "shadow",
        "$value": {
          "color": "#32180b47",
          "offsetX": "0px",
          "offsetY": "22px",
          "blur": "46px",
          "spread": "-20px"
        }
      }
    },
    "photo": {
      "$type": "shadow",
      "$value": {
        "color": "#32180b29",
        "offsetX": "0px",
        "offsetY": "6px",
        "blur": "16px",
        "spread": "-6px"
      },
      "$description": "Polaroids and cut-out photos."
    },
    "overlay": {
      "$type": "shadow",
      "$value": {
        "color": "#32180b2e",
        "offsetX": "0px",
        "offsetY": "16px",
        "blur": "40px",
        "spread": "-12px"
      },
      "$description": "Menus and popovers only."
    }
  },
  "motion": {
    "duration": {
      "instant": {
        "$type": "duration",
        "$value": "80ms"
      },
      "fast": {
        "$type": "duration",
        "$value": "150ms"
      },
      "base": {
        "$type": "duration",
        "$value": "240ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "400ms"
      },
      "marquee": {
        "$type": "duration",
        "$value": "40s",
        "$description": "One full loop of a marquee ribbon."
      },
      "seal": {
        "$type": "duration",
        "$value": "24s",
        "$description": "One full rotation of a spinning seal."
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [0.2, 0, 0, 1]
      },
      "out": {
        "$type": "cubicBezier",
        "$value": [0.16, 1, 0.3, 1]
      },
      "bounce": {
        "$type": "cubicBezier",
        "$value": [0.34, 1.56, 0.64, 1],
        "$description": "Playful press and pop for stickers and buttons."
      }
    }
  },
  "pattern": {
    "$description": "Sizes for the signature patterns (stripes, gingham, checker, grid paper, dots, scallops).",
    "stripe": {
      "narrow": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "base": {
        "$type": "dimension",
        "$value": "1.5rem"
      },
      "wide": {
        "$type": "dimension",
        "$value": "2.5rem"
      },
      "xl": {
        "$type": "dimension",
        "$value": "4rem",
        "$description": "Wide process-section stripes (pin 02)."
      }
    },
    "gingham": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "checker": {
      "$type": "dimension",
      "$value": "2rem"
    },
    "grid": {
      "$type": "dimension",
      "$value": "1.25rem"
    },
    "dot": {
      "$type": "dimension",
      "$value": "1.25rem"
    },
    "scallop": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "notebook-hole": {
      "$type": "dimension",
      "$value": "0.875rem",
      "$description": "Notebook holes along the schedule card (pin 15)."
    }
  }
}

{
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["Bodoni Moda", "Didot", "Bodoni 72", "Georgia", "serif"],
        "$description": "Bodoni Moda, the Italian Didone: headlines, prices and the logo. Variable: opsz 6-96, wght 400-900, italic."
      },
      "body": {
        "$type": "fontFamily",
        "$value": ["DM Sans", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
        "$description": "Body, UI and labels; 800-900 for the heavy title moment of pin 16."
      },
      "script": {
        "$type": "fontFamily",
        "$value": ["Pinyon Script", "Snell Roundhand", "cursive"],
        "$description": "Formal script for one accent word, the \"by Mom\" in the logo and signatures (pins 10, 16). 32px and up."
      },
      "hand": {
        "$type": "fontFamily",
        "$value": ["Cormorant Garamond", "Garamond", "Georgia", "serif"],
        "$description": "Cormorant Garamond for Mom's notes, captions and eyebrow labels: a fine old-style serif, set in italic."
      },
      "bubble": {
        "$type": "fontFamily",
        "$value": ["Bodoni Moda", "Didot", "Georgia", "serif"],
        "$description": "Retired bubble face: now the display serif, so old uses stay elegant."
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      },
      "extrabold": {
        "$type": "fontWeight",
        "$value": 800
      },
      "black": {
        "$type": "fontWeight",
        "$value": 900
      }
    },
    "variation": {
      "$description": "font-variation-settings presets for Fraunces.",
      "display": {
        "$value": "\"SOFT\" 100, \"WONK\" 0",
        "$description": "Default headline: fully soft."
      },
      "soft": {
        "$value": "\"SOFT\" 100, \"WONK\" 1",
        "$description": "Puffy retro look for the logo and playful moments (pin 11)."
      },
      "crisp": {
        "$value": "\"SOFT\" 30, \"WONK\" 0",
        "$description": "Crisper serif for short uppercase titles."
      }
    }
  },
  "text": {
    "$description": "Text styles from the brand kit. The UI package exposes them as .bbm-text-<style> classes. Display sizes are fluid between the values in $extensions.",
    "display-xl": {
      "family": {
        "$type": "fontFamily",
        "$value": "{font.family.display}"
      },
      "size": {
        "$value": "clamp(2.5rem, min(1.6rem + 3.2vw, 0.5rem + 8svh), 5rem)",
        "$extensions": {
          "bbm.fluid": {
            "min": "40px",
            "max": "80px"
          }
        }
      },
      "line-height": {
        "$type": "number",
        "$value": 0.98
      },
      "tracking": {
        "$type": "dimension",
        "$value": "-0.02em"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.medium}"
      }
    },
    "display-lg": {
      "family": {
        "$type": "fontFamily",

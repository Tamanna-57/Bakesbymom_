{
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["Fraunces", "Iowan Old Style", "Georgia", "serif"],
        "$description": "Soft serif for headlines, prices and the logo (pins 02, 05, 11, 13, 15). Variable: opsz, wght 100-900, SOFT 0-100, WONK 0-1."
      },
      "body": {
        "$type": "fontFamily",
        "$value": ["DM Sans", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
        "$description": "Body, UI and labels; 800-900 for the heavy title moment of pin 16."
      },
      "script": {
        "$type": "fontFamily",
        "$value": ["Pinyon Script", "Snell Roundhand", "cursive"],
        "$description": "Formal script for one accent word, the \"by Mom\" in the logo and signatures (pins 10, 16). 32px and up."
      },
      "hand": {
        "$type": "fontFamily",
        "$value": ["Caveat", "Bradley Hand", "cursive"],
        "$description": "Handwritten notes, captions and pill labels (pins 01, 04, 13, 15). 20px and up."
      },
      "bubble": {
        "$type": "fontFamily",
        "$value": ["Cherry Bomb One", "Arial Rounded MT Bold", "system-ui", "sans-serif"],
        "$description": "Bubble display for one word per page, always outlined (pins 01, 11). 64px and up."
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      },
      "extrabold": {
        "$type": "fontWeight",
        "$value": 800
      },
      "black": {
        "$type": "fontWeight",
        "$value": 900
      }
    },
    "variation": {
      "$description": "font-variation-settings presets for Fraunces.",
      "display": {
        "$value": "\"SOFT\" 100, \"WONK\" 0",
        "$description": "Default headline: fully soft."
      },
      "soft": {
        "$value": "\"SOFT\" 100, \"WONK\" 1",
        "$description": "Puffy retro look for the logo and playful moments (pin 11)."
      },
      "crisp": {
        "$value": "\"SOFT\" 30, \"WONK\" 0",
        "$description": "Crisper serif for short uppercase titles."
      }
    }
  },
  "text": {
    "$description": "Text styles from the brand kit. The UI package exposes them as .bbm-text-<style> classes. Display sizes are fluid between the values in $extensions.",
    "display-xl": {
      "family": {
        "$type": "fontFamily",
        "$value": "{font.family.display}"
      },
      "size": {
        "$value": "clamp(3rem, 2.2rem + 3.6vw, 5.5rem)",
        "$extensions": {
          "bbm.fluid": {
            "min": "48px",
            "max": "88px"
          }
        }
      },
      "line-height": {
        "$type": "number",
        "$value": 0.98
      },
      "tracking": {
        "$type": "dimension",
        "$value": "-0.02em"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.semibold}"
